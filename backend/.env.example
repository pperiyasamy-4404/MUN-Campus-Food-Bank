# Copy this file to .env and fill in the password for the foodbank_app login.
# .env is never committed.
DATABASE_URL=postgresql+psycopg://foodbank_app:PASSWORD@localhost:5432/campus_food_bank
TEST_DATABASE_URL=postgresql+psycopg://foodbank_app:PASSWORD@localhost:5432/campus_food_bank_test

# The key for every keyed hash (HMAC): ID numbers, setup codes, trusted devices.
# Make one with:  .venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
# Never change it and never lose it: no card can be matched to an account without it (P2, P11).
SECRET_KEY=

# Uncomment only to try the site from a phone on the home network (plain http).
# COOKIE_SECURE=false

# Database connections per server process (default 15). Each process also works on
# only this many requests at once (app/door.py). The cloud database must allow this
# many for every server process, plus a few for the jobs script.
# DB_CONNECTIONS=15

# FastAPI's page listing every address, at http://localhost:8000/docs. Off unless
# turned on, because on the live site it would show anyone every address.
# API_DOCS=true

# Where server errors (500s) are written. Leave it out for backend/errors.log.
# ERROR_LOG=
